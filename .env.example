# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=hargus
POSTGRES_PASSWORD=hargus
POSTGRES_DB=hargus

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Redis (Langfuse queue) ────────────────────────────────────────────────────
REDIS_PASSWORD=langfuse-redis-dev

# ── ClickHouse (Langfuse analytics) ──────────────────────────────────────────
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse-dev-password

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_SALT=dev-langfuse-salt-change-in-prod
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_NEXTAUTH_SECRET=dev-secret-change-in-prod

# ── LLM / API keys (set your own) ─────────────────────────────────────────────
HARGUS_LLM_MODEL=openai/gpt-oss-20b:free
HARGUS_OPENAI_API_KEY=
HARGUS_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── Langfuse project keys (created in Langfuse UI after first docker compose up) ──
HARGUS_LANGFUSE_PUBLIC_KEY=pk-lf-cba83f33-ba8c-4ecf-a3dc-ba72135f8bd8
HARGUS_LANGFUSE_SECRET_KEY=sk-lf-4326cf16-44a6-478c-9c5d-a16f67b1a30c
