# Application
HARGUS_APP_NAME=Hargus AI API
HARGUS_ENVIRONMENT=development
HARGUS_FRONTEND_ORIGIN=http://localhost:3000

# Database
HARGUS_DATABASE_URL=postgresql+asyncpg://hargus:hargus@localhost:5432/hargus

# Temporal
HARGUS_TEMPORAL_ENABLED=true
HARGUS_TEMPORAL_SERVER_URL=localhost:7233
HARGUS_TEMPORAL_NAMESPACE=default
HARGUS_TEMPORAL_TASK_QUEUE=hargus-ai

# Storage: local | s3
# Use s3 with the MinIO endpoint below when running alongside Docker services
HARGUS_STORAGE_BACKEND=s3
HARGUS_S3_BUCKET=hargus
HARGUS_S3_ENDPOINT_URL=http://localhost:9000
HARGUS_AWS_ACCESS_KEY_ID=minioadmin
HARGUS_AWS_SECRET_ACCESS_KEY=minioadmin
HARGUS_AWS_REGION=us-east-1
HARGUS_S3_PREFIX=

# Local storage (only used when STORAGE_BACKEND=local)
HARGUS_LOCAL_STORAGE_PATH=./data/files

# LLM Provider: ollama | openai | anthropic | bedrock
HARGUS_LLM_PROVIDER=ollama
HARGUS_LLM_MODEL=llama3.1
HARGUS_LLM_TEMPERATURE=0.1

# Embeddings: ollama | openai | bedrock
HARGUS_EMBEDDING_PROVIDER=ollama
HARGUS_EMBEDDING_MODEL=nomic-embed-text

# Ollama (used when provider=ollama)
HARGUS_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (used when provider=openai)
# HARGUS_OPENAI_API_KEY=sk-...

# Anthropic (used when provider=anthropic)
# HARGUS_ANTHROPIC_API_KEY=sk-ant-...

# Langfuse observability
HARGUS_LANGFUSE_ENABLED=false
HARGUS_LANGFUSE_HOST=http://localhost:3001
HARGUS_LANGFUSE_PUBLIC_KEY=pk-lf-...
HARGUS_LANGFUSE_SECRET_KEY=sk-lf-...
